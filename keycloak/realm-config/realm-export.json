{
  "realm": "school-scheduler",
  "enabled": true,
  "users": [
    {
      "username": "student1",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "studentpass" }],
      "realmRoles": ["USER"]
    },
    {
      "username": "admin1",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "adminpass" }],
      "realmRoles": ["ADMIN"]
    }
  ],
  "roles": {
    "realm": [
      { "name": "USER" },
      { "name": "ADMIN" }
    ]
  },
  "clients": [
    {
      "clientId": "spring-app",
      "publicClient": true,
      "redirectUris": ["http://localhost:8080/*"],
      "webOrigins": ["+"],
      "protocol": "openid-connect"
    }
  ]
}
